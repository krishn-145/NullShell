  NullShell /path/to/proj   -> us folder ko build karo (nested manifest bhi dhundta hai)
  NullShell --setup         -> sirf tools install/setup karo
  NullShell --install       -> GLOBAL command bana do (NullShell / nullshell)
  NullShell --owner         -> owner details
  NullShell --help          -> yeh help

Apna saara code ek hi folder me rakho, us folder me jao, aur likho:  NullShell
- Build ke waqt minSdk=${MINSDK}, targetSdk=${TARGETSDK} force hote hain
  (purana manifest bhi chalega) -> Android 5 se 16+ tak install.
- Manifest root me na ho to subfolders me dhundh leta hai.
- android.jar zip me bundled hai - internet ke bina bhi chalta hai.
Har build ke baad APK:  <project>/NullShell/<AppName>.apk
EOF
}

show_owner() {
  printf '\n'
  printf '   %sTool%s    : %s v%s\n' "$D" "$N" "$TOOL_NAME" "$TOOL_VER"
  printf '   %sOwner%s   : %s%s%s\n' "$D" "$N" "$Y" "$OWNER_NAME" "$N"
  printf '   %sGitHub%s  : %s%s%s  (%s)\n' "$D" "$N" "$W" "$OWNER_GH" "$N" "$OWNER_GHU"
  printf '   %sTelegram%s: %s%s%s  (%s)\n' "$D" "$N" "$BL" "$OWNER_TG" "$N" "$OWNER_TGU"
  printf '   %sInsta%s   : %s%s%s  (%s)\n' "$D" "$N" "$MG" "$OWNER_IG" "$N" "$OWNER_IGU"
  printf '\n'
}

#---------------------------------------------------------------------
# Main
#---------------------------------------------------------------------
main() {
  verify_owner
  command -v clear >/dev/null 2>&1 && clear
  banner
  need_termux

  case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    --owner) show_owner; exit 0 ;;
    --version|-v) echo "$TOOL_NAME v$TOOL_VER"; exit 0 ;;
  esac

  install_pkgs
  setup_java
  get_android_jar
  get_keystore
  pick_dexer

  case "${1:-}" in
    --setup) ok "Setup complete. Ab 'NullShell' chalao build ke liye."; exit 0 ;;
    --install) install_self; exit 0 ;;
    *) build_project "${1:-$PWD}" ;;
  esac
}

main "$@"
