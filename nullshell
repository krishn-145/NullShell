}

_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 | awk '{print $NF}'
  else
    echo "NO_HASH_TOOL"
  fi
}

verify_owner() {
  local got
  got="$(_owner_data | _sha256)"
  if [ "$got" = "NO_HASH_TOOL" ]; then
    err "Integrity engine (sha256sum/openssl) nahi mila."
    die "Termux me 'pkg install coreutils' chalao."
  fi
  if [ "$got" != "$OWNER_SEAL" ]; then
    echo
    printf '%s############################################################%s\n' "$R" "$N"
    printf '%s#          !!!   T A M P E R   D E T E C T E D   !!!        #%s\n' "$R" "$N"
    printf '%s#   Owner identity block modiya gaya hai.                  #%s\n' "$R" "$N"
