# Paths / config
#---------------------------------------------------------------------
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME_T="${HOME:-/data/data/com.termux/files/home}"
BASE="$HOME_T/.nullshell"
TOOLZ="$BASE/toolz"
ANDROID_JAR="$TOOLZ/android.jar"
KS="$BASE/nullshell.keystore"
KSPASS="nullshell123"
KSALIAS="nullshellkey"
SELF="$0"
SELF_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"

#---------------------------------------------------------------------
# 1. Environment checks
#---------------------------------------------------------------------
need_termux() {
  [ -d "$PREFIX" ] || die "Yeh Termux me nahi chal raha. Pehle Termux install karo."
  case "$(uname -m)" in
    aarch64|armv7l|armv8l|i686|x86_64) : ;;
    *) warn "Unknown CPU arch: $(uname -m) - try kar rahe hain." ;;
  esac
}

#---------------------------------------------------------------------
# 2. Install required packages (idempotent)
#---------------------------------------------------------------------
install_pkgs() {
  log "Packages check kar raha hoon..."
  pkg update -y >/dev/null 2>&1 || true
  log "Zaroori tools install kar raha hoon..."
  pkg install -y openjdk-17 aapt2 apksigner zip unzip curl wget coreutils \
      >/dev/null 2>&1 || true
  for p in d8 dx zipalign openssl; do
    pkg install -y "$p" >/dev/null 2>&1 || true
  done
  ok "Packages ready."
}

#---------------------------------------------------------------------
# 3. Locate Java
#---------------------------------------------------------------------
setup_java() {
  JAVA_HOME=""
  for d in "$PREFIX"/lib/jvm/java-*-openjdk "$PREFIX"/opt/openjdk; do
    [ -x "$d/bin/javac" ] && JAVA_HOME="$d"
  done
  [ -n "$JAVA_HOME" ] || die "Java (javac) nahi mila. 'pkg install openjdk-17' chalao."
  export JAVA_HOME
  export PATH="$JAVA_HOME/bin:$PATH"
  ok "Java mil gaya: $($JAVA_HOME/bin/javac -version 2>&1)"
}

#---------------------------------------------------------------------
# 4. Get android.jar (bundled first, download only as last resort)
#---------------------------------------------------------------------
get_android_jar() {
  mkdir -p "$TOOLZ"
  if [ -f "$ANDROID_JAR" ] && [ -s "$ANDROID_JAR" ]; then
    ok "android.jar pehle se ready hai."; return
  fi
  if [ -n "$SELF_DIR" ] && [ -s "$SELF_DIR/toolz/android.jar" ]; then
    cp "$SELF_DIR/toolz/android.jar" "$ANDROID_JAR"
    ok "Bundled android.jar use kiya (offline)."; return
  fi
  if [ -s "./toolz/android.jar" ]; then
    cp ./toolz/android.jar "$ANDROID_JAR"; ok "android.jar project ke toolz/ se liya."; return
  fi
  log "android.jar download kar raha hoon (API 30 stubs)..."
  local urls=(
    "https://github.com/Sable/android-platforms/raw/master/android-30/android.jar"
    "https://github.com/Sable/android-platforms/raw/master/android-33/android.jar"
    "https://raw.githubusercontent.com/Sable/android-platforms/master/android-30/android.jar"
  )
  local u
  for u in "${urls[@]}"; do
    if curl -L --fail --connect-timeout 20 -o "$ANDROID_JAR.tmp" "$u" 2>/dev/null \
       && [ -s "$ANDROID_JAR.tmp" ]; then
      mv "$ANDROID_JAR.tmp" "$ANDROID_JAR"; ok "android.jar download ho gaya."; return
    fi
  done
  rm -f "$ANDROID_JAR.tmp"
  die "android.jar nahi mila. NullShell ke saath 'toolz/android.jar' rakho (zip me included hai)."
}

#---------------------------------------------------------------------
# 5. Create signing keystore (once)
#---------------------------------------------------------------------
get_keystore() {
  mkdir -p "$BASE"
  if [ -f "$KS" ]; then ok "Signing keystore pehle se hai."; return; fi
  log "Naya signing keystore bana raha hoon..."
  keytool -genkeypair -keystore "$KS" -alias "$KSALIAS" \
     -keyalg RSA -keysize 2048 -validity 10000 \
     -storepass "$KSPASS" -keypass "$KSPASS" \
     -dname "CN=${TOOL_NAME}, O=Termux, C=IN" >/dev/null 2>&1 \
     && ok "Keystore ready." || die "Keystore banane me error aaya."
}

#---------------------------------------------------------------------
# 6. Detect build tools
#---------------------------------------------------------------------
pick_dexer() {
  if command -v d8 >/dev/null 2>&1; then DEXER="d8"
  elif command -v dx >/dev/null 2>&1; then DEXER="dx"
  else die "d8/dx nahi mila. 'pkg install d8' chalao."; fi
  ok "DEX converter: $DEXER"
}

#---------------------------------------------------------------------
# Find AndroidManifest.xml (root or nested), or scaffold a starter app
#---------------------------------------------------------------------
locate_or_scaffold() {
  local root="$1"
  cd "$root" 2>/dev/null || die "Folder nahi mila: $root"

  [ -f AndroidManifest.xml ] && return 0

  log "Manifest root me nahi hai - subfolders me dhundh raha hoon..."
  local found
  found=$(find . -maxdepth 4 -name AndroidManifest.xml \
            -not -path '*/.nullshell-build/*' 2>/dev/null | head -1)
  if [ -n "$found" ]; then
    cd "$(dirname "$found")" || die "Manifest folder me ja nahi paya."
    ok "Manifest mila: $PWD"
    return 0
  fi

  local java_count
  java_count=$(find . -maxdepth 4 -name '*.java' 2>/dev/null | wc -l | tr -d ' ')
  if [ "$java_count" -gt 0 ]; then
    warn "Yahan .java files hain lekin AndroidManifest.xml nahi mila."
    die "Manifest ko project root me rakho, ya kisi aur folder par chalao."
  fi

  warn "Is folder me koi project nahi mila: $root"
  log "Turant build test karne ke liye ek starter app bana raha hoon..."
  scaffold_project "$root"
}

scaffold_project() {
  local root="$1"
  cd "$root" 2>/dev/null || die "Folder me ja nahi paya: $root"
  local raw appname pkg pkgpath
  raw="$(basename "$root")"
  appname="$(printf '%s' "$raw" | tr -cd 'A-Za-z0-9 _-')"
  [ -z "$appname" ] && appname="NullApp"
  pkg="com.nullshell.$(printf '%s' "$raw" | tr -cd 'a-z0-9' | tr 'A-Z' 'a-z')"
  [ "$pkg" = "com.nullshell." ] && pkg="com.nullshell.app"
  pkgpath="$(printf '%s' "$pkg" | tr '.' '/')"

  mkdir -p "res/layout" "res/values" "src/$pkgpath"

  cat > AndroidManifest.xml <<EOF
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="$pkg"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="$MINSDK" android:targetSdkVersion="$TARGETSDK" />
    <application
        android:label="$appname"
        android:allowBackup="true"
        android:debuggable="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
EOF

  cat > res/values/strings.xml <<EOF
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">$appname</string>
    <string name="tagline">NullShell se build hua - kisi bhi Android par install!</string>
</resources>
EOF

  cat > res/layout/activity_main.xml <<'EOF'
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D0D0D"
    android:padding="24dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FF1744"
        android:textSize="30sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/tagline"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center" />
</LinearLayout>
EOF

  cat > "src/$pkgpath/MainActivity.java" <<EOF
package $pkg;

import android.app.Activity;
import android.os.Bundle;
import android.widget.Toast;

public class MainActivity extends Activity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);
        Toast.makeText(this, "NullShell build OK!", Toast.LENGTH_LONG).show();
    }
}
EOF

  ok "Starter app bana diya (package: $pkg)."
}

#---------------------------------------------------------------------
# Prepare a FIXED manifest copy (modern min/target SDK, no maxSdk block)
# so the APK installs on any Android 5 -> 16+ device.
#---------------------------------------------------------------------
prepare_manifest() {
  local B="$1"
  local M="$B/AndroidManifest.xml"
  cp AndroidManifest.xml "$M"

  # remove any maxSdkVersion (it would block install on newer devices)
  sed -i -E 's/ *android:maxSdkVersion="[0-9]+"//g' "$M"

  # override existing min/target sdk values
  sed -i -E "s/android:minSdkVersion=\"[0-9]+\"/android:minSdkVersion=\"$MINSDK\"/g" "$M"
  sed -i -E "s/android:targetSdkVersion=\"[0-9]+\"/android:targetSdkVersion=\"$TARGETSDK\"/g" "$M"

  # if a <uses-sdk> exists but is missing one of the attributes, add it
  if grep -q '<uses-sdk' "$M"; then
    grep -q 'minSdkVersion' "$M"    || sed -i -E "s#(<uses-sdk)#\1 android:minSdkVersion=\"$MINSDK\"#" "$M"
    grep -q 'targetSdkVersion' "$M" || sed -i -E "s#(<uses-sdk)#\1 android:targetSdkVersion=\"$TARGETSDK\"#" "$M"
  fi
  # if there is no <uses-sdk> at all, aapt2 flags below will inject one
}

#---------------------------------------------------------------------
# 7. Build
#---------------------------------------------------------------------
build_project() {
  local dir="${1:-$PWD}"
  locate_or_scaffold "$dir"

  [ -f AndroidManifest.xml ] || die "AndroidManifest.xml nahi mila: $PWD"

  log "Project: $PWD"

  local PKG LABEL NAME
  PKG=$(grep -oE 'package="[^"]+"' AndroidManifest.xml | head -1 | sed 's/package="//; s/"//')
  LABEL=$(grep -oE 'android:label="[^"]+"' AndroidManifest.xml | head -1 | sed 's/android:label="//; s/"//')
  [ -z "$PKG" ] && die "AndroidManifest.xml me package= nahi mila."
  case "$LABEL" in ""|@string/*) LABEL="${PKG##*.}";; esac
  NAME=$(printf '%s' "$LABEL" | tr -d ' /\\:*?"<>|')

  printf '   %spackage%s   : %s\n   %sminSdk%s    : %s   %s(forced)%s\n   %stargetSdk%s : %s   %s(forced - install-friendly)%s\n   %sapp name%s  : %s\n' \
         "$D" "$N" "$PKG" "$D" "$N" "$MINSDK" "$D" "$N" \
         "$D" "$N" "$TARGETSDK" "$D" "$N" "$D" "$N" "$NAME"

  local RESDIR="" ASSETDIR="" d
  for d in res app/src/main/res; do [ -d "$d" ] && RESDIR="$d" && break; done
  for d in assets app/src/main/assets; do [ -d "$d" ] && ASSETDIR="$d" && break; done

  local SRCDIRS=()
  for d in src java app/src/main/java gen; do [ -d "$d" ] && SRCDIRS+=("$d"); done
  [ ${#SRCDIRS[@]} -gt 0 ] || die "Koi source folder (src/ ya java/) nahi mila."

  local B="$PWD/.nullshell-build"
  rm -rf "$B"
  mkdir -p "$B/gen" "$B/classes" "$B/dex" "$B/out"

  # fixed manifest copy
  prepare_manifest "$B"

  step 1 "Resources compile (aapt2)..."
  local LINK_INPUT=""
  if [ -n "$RESDIR" ]; then
    aapt2 compile --dir "$RESDIR" -o "$B/res.zip" || die "aapt2 compile fail."
    LINK_INPUT="$B/res.zip"; ok "Resources compiled."
  else
    warn "res/ folder nahi mila - bina resources ke build."
  fi

  step 2 "Manifest + resources link (aapt2)..."
  local LINK_ARGS=(-I "$ANDROID_JAR" --manifest "$B/AndroidManifest.xml"
                   --java "$B/gen" -o "$B/out/base.apk" --auto-add-overlay
                   --min-sdk-version "$MINSDK" --target-sdk-version "$TARGETSDK")
  [ -n "$ASSETDIR" ] && LINK_ARGS+=(-A "$ASSETDIR")
  [ -n "$LINK_INPUT" ] && LINK_ARGS+=("$LINK_INPUT")
  aapt2 link "${LINK_ARGS[@]}" || die "aapt2 link fail. Manifest/resources check karo."
  ok "Resources linked, R.java generated."

  step 3 "Java compile (javac)..."
  find "${SRCDIRS[@]}" -name '*.java' ! -name 'R.java' > "$B/sources.txt" 2>/dev/null
  find "$B/gen" -name '*.java' >> "$B/sources.txt" 2>/dev/null
  [ -s "$B/sources.txt" ] || die "Koi .java file nahi mili. src/ folder me code hai?"
  "$JAVA_HOME/bin/javac" --release 9 -encoding UTF-8 \
      -d "$B/classes" -cp "$ANDROID_JAR" @"$B/sources.txt" \
      || die "Java compile fail. Upar wala error dekho."
  ok "Java compiled ($(wc -l < "$B/sources.txt") file)."

  step 4 "DEX convert ($DEXER)..."
  local CLS=()
  mapfile -t CLS < <(find "$B/classes" -name '*.class')
  [ ${#CLS[@]} -gt 0 ] || die "Koi .class nahi bana."
  if [ "$DEXER" = "d8" ]; then
    d8 --lib "$ANDROID_JAR" --min-api "$MINSDK" --output "$B/dex" "${CLS[@]}" \
       || die "d8 fail. Library jar Java version check karo."
  else
    dx --dex --output="$B/dex/classes.dex" "${CLS[@]}" || die "dx fail."
  fi
  [ -f "$B/dex/classes.dex" ] || die "classes.dex nahi bana."
  ok "classes.dex ready."

  step 5 "Package + align..."
  cp "$B/out/base.apk" "$B/out/unsigned.apk"
  zip -ujq "$B/out/unsigned.apk" "$B/dex/classes.dex" \
      || die "classes.dex APK me add nahi hua."
  if command -v zipalign >/dev/null 2>&1; then
    zipalign -f -p 4 "$B/out/unsigned.apk" "$B/out/aligned.apk" \
      && ok "APK aligned." || { cp "$B/out/unsigned.apk" "$B/out/aligned.apk"; warn "zipalign skip."; }
  else
    cp "$B/out/unsigned.apk" "$B/out/aligned.apk"; warn "zipalign nahi mila - skip."
  fi

  step 6 "Sign (apksigner)..."
  mkdir -p "NullShell"
  local OUT="NullShell/${NAME}.apk"
  apksigner sign --ks "$KS" --ks-pass "pass:$KSPASS" --ks-key-alias "$KSALIAS" \
     --key-pass "pass:$KSPASS" --min-sdk-version "$MINSDK" \
     --v1-signing-enabled true --v2-signing-enabled true --v3-signing-enabled true \
     --out "$OUT" "$B/out/aligned.apk" \
     || die "apksigner fail."
  ok "APK signed."

  if [ -d "$HOME_T/storage/downloads" ]; then
    cp "$OUT" "$HOME_T/storage/downloads/${NAME}.apk" 2>/dev/null && \
      ok "Copy: /sdcard/Download/${NAME}.apk"
  fi

  # verify signature + show sdk
  command -v apksigner >/dev/null 2>&1 && \
    { apksigner verify "$OUT" >/dev/null 2>&1 && ok "Signature verify PASS" || warn "Verify fail."; }
  if command -v aapt2 >/dev/null 2>&1; then
    local SDKINFO
    SDKINFO=$(aapt2 dump badging "$OUT" 2>/dev/null | grep -E "sdkVersion|targetSdkVersion" | head -2)
    [ -n "$SDKINFO" ] && printf '   %s%s%s\n' "$D" "$SDKINFO" "$N"
  fi

  local SIZE; SIZE=$(du -h "$OUT" 2>/dev/null | cut -f1)
  echo
  printf '%s      ★  BUILD  SUCCESS  ★%s\n' "$GR" "$N"
  printf '      %sAPK%s    : %s%s%s\n'  "$D" "$N" "$W" "$PWD/$OUT" "$N"
  printf '      %sSize%s   : %s%s%s\n'  "$D" "$N" "$CY" "$SIZE" "$N"
  printf '      %sminSDK%s : %s%s%s    %stargetSDK%s : %s%s%s\n' \
         "$D" "$N" "$Y" "$MINSDK" "$N" "$D" "$N" "$Y" "$TARGETSDK" "$N"
  printf '      %sInstall%s: %stermux-open %s%s\n' "$D" "$N" "$GR" "$OUT" "$N"
  printf '      %sBuilt by %s%s  %s.%s  %sOwner %s%s\n' \
         "$D" "$N" "$TOOL_NAME" "$D" "$N" "$D" "$OWNER_NAME" "$N"
  printf '      %sTip: agar "App not installed" aaye to purana version pehle uninstall karo.%s\n' "$D" "$N"
  echo
}

#---------------------------------------------------------------------
# Install self as a GLOBAL command (works after closing Termux too)
#---------------------------------------------------------------------
install_self() {
  mkdir -p "$PREFIX/bin" "$TOOLZ"
  if [ -f "$SELF" ]; then
    cp "$SELF" "$PREFIX/bin/nullshell" 2>/dev/null || cat "$SELF" > "$PREFIX/bin/nullshell"
  else
    die "Install fail: script file nahi mila ($SELF)."
  fi
  chmod +x "$PREFIX/bin/nullshell"
  cp "$PREFIX/bin/nullshell" "$PREFIX/bin/NullShell" 2>/dev/null
  chmod +x "$PREFIX/bin/NullShell"
  if [ ! -s "$ANDROID_JAR" ]; then
    if [ -n "$SELF_DIR" ] && [ -s "$SELF_DIR/toolz/android.jar" ]; then
      cp "$SELF_DIR/toolz/android.jar" "$ANDROID_JAR"
      ok "android.jar bhi install kar diya (offline ready)."
    elif [ -s "./toolz/android.jar" ]; then
      cp "./toolz/android.jar" "$ANDROID_JAR"
      ok "android.jar bhi install kar diya (offline ready)."
    fi
  fi
  ok "GLOBAL install ho gaya!"
  printf '   Ab Termux band karne ke baad bhi, kisi bhi folder me sirf likho:\n'
  printf '        %sNullShell%s     (ya  %snullshell%s)\n' "$GR" "$N" "$GR" "$N"
  printf '   Wahi folder build hoga jisme aap khade ho.\n'
}

