#---------------------------------------------------------------------
# Colors (256-color) + log helpers
#---------------------------------------------------------------------
R=$'\033[1;38;5;196m'   # red
O=$'\033[1;38;5;208m'   # orange
Y=$'\033[1;38;5;226m'   # yellow
GR=$'\033[1;38;5;46m'   # green
CY=$'\033[1;38;5;51m'   # cyan
BL=$'\033[1;38;5;39m'   # blue
MG=$'\033[1;38;5;201m'  # magenta
PK=$'\033[1;38;5;171m'  # pink
W=$'\033[1;37m'         # white
D=$'\033[2;37m'         # dim
N=$'\033[0m'            # reset

log()  { printf '%s [>] %s %s\n'  "$CY" "$N" "$1"; }
ok()   { printf '%s [OK] %s %s\n' "$GR" "$N" "$1"; }
warn() { printf '%s [!] %s %s\n'  "$Y"  "$N" "$1"; }
err()  { printf '%s [X] %s %s\n'  "$R"  "$N" "$1"; }
die()  { err "$1"; echo; exit 1; }

# colorful per-step header (no boring rule lines)
step() {
  local c
  case "$1" in
    1) c=$R ;; 2) c=$O ;; 3) c=$Y ;;
    4) c=$GR ;; 5) c=$CY ;; 6) c=$MG ;; *) c=$W ;;
  esac
  printf '%s   >> [%s/6]%s %s%s%s\n' "$c" "$1" "$N" "$W" "$2" "$N"
}

#---------------------------------------------------------------------
# Colorful banner
#---------------------------------------------------------------------
banner() {
  local cols=(196 208 226 46 51 39 201 171 45)
  local letters=(N U L L S H E L L)
  local rb="" i
  for i in 0 1 2 3 4 5 6 7 8; do
    rb+=$'\033[1;38;5;'"${cols[$i]}"'m'"${letters[$i]}"$'\033[0m'
    [ "$i" -lt 8 ] && rb+=" "
  done

  printf '\n'
  printf '      %s\n' "$rb"
  printf '      %sTermux Android APK Builder%s  %s.%s  %sv%s%s\n' \
         "$W" "$N" "$D" "$N" "$PK" "$TOOL_VER" "$N"
  printf '      %sJava%s %s>%s %sDEX%s %s>%s %sSigned APK%s\n' \
         "$Y" "$N" "$D" "$N" "$O" "$N" "$D" "$N" "$GR" "$N"
  printf '\n'
  printf '      %s*%s %sOWNER%s      %s%s%s\n'  "$Y" "$N" "$D" "$N" "$Y" "$OWNER_NAME" "$N"
  printf '      %s>%s %sGitHub%s     %s%s%s\n'  "$W" "$N" "$D" "$N" "$W" "$OWNER_GH" "$N"
  printf '      %s>%s %sTelegram%s   %s%s%s\n'  "$BL" "$N" "$D" "$N" "$BL" "$OWNER_TG" "$N"
  printf '      %s>%s %sInstagram%s  %s%s%s\n'  "$MG" "$N" "$D" "$N" "$MG" "$OWNER_IG" "$N"
  printf '\n'
}

